# Paper2Video 环境变量模板
# 用法：复制为 .env 并填入真实 Key。.env 已在 .gitignore 中，不会进版本库。
#
#   copy .env.example .env
#
# 所有值都不要加引号，不要留行尾空格。

# ──────────────────────────────────────────────────────────────
# 一、API 供应商（Phase 0 收敛：从 4 家砍到 2 家）
# ──────────────────────────────────────────────────────────────

# DeepSeek 开放平台 —— 承担语言推理 + 图像视觉（OpenAI 兼容接口）
# 申请地址：https://platform.deepseek.com/api_keys
# 说明：camel 的 OPENAI_COMPATIBLE_MODEL 分支会读 OPENAI_API_BASE / OPENAI_API_KEY，
#       所以这两个变量名必须用 OPENAI_ 前缀。
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-你的DeepSeekKey

# 阿里百炼（DashScope）—— 仅用于「AI 观众 / VideoLLM」环节的视频理解
# 申请地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-你的百炼Key

# Gemini —— 仅在显式传 --model_name_t gemini-* 时才需要，默认流程不用
GEMINI_API_KEY=

# ──────────────────────────────────────────────────────────────
# 二、模型权重存放位置（必须是纯英文路径！）
# ──────────────────────────────────────────────────────────────
# 为什么必须纯英文：项目位于 E:\Development\26年\... ，路径含中文。
# Wan / InfiniteTalk 系的模型加载器对非 ASCII 路径会直接报错，因此权重一律外置。

# HuggingFace 缓存根目录（E 盘 SSD，读权重是随机 IO，机械盘会拖慢十倍以上）
HF_HOME=E:\ai-models\hf
# 国内镜像。若你本地有稳定代理可注释掉此行改用官方源
HF_ENDPOINT=https://hf-mirror.com
# 让 huggingface_hub 用 hf_transfer 多线程下载（可选，需 pip install hf_transfer）
HF_HUB_ENABLE_HF_TRANSFER=0

# ModelScope 缓存（CAM++ 声纹模型从这里取）
MODELSCOPE_CACHE=E:\ai-models\modelscope

# torch.hub / 权重临时目录
TORCH_HOME=E:\ai-models\torch

# 主模型权重（scripts/download_models.py 的落地目录，代码从这里按绝对路径加载）
PAPER2VIDEO_WEIGHTS=E:\ai-models\weights

# 手动下载的大权重（InfiniteTalk 等）统一放这里
PAPER2VIDEO_CKPT_DIR=E:\ai-models\checkpoints

# 冒烟测试产物目录（必须纯英文，ffmpeg 的 ass 滤镜解析不了中文路径）
PAPER2VIDEO_SMOKE_DIR=E:\ai-models\smoke

# 中文路径兼容层（scripts/fix_cjk_path.py 把受影响的包镜像到这里）
# 项目路径含中文时，编译型扩展在 C/C++ 层用窄字符路径打开文件会失败
# （实测 nagisa 依赖的 DyNet 读不了 ...\26年\...\nagisa_v001.model）
PAPER2VIDEO_VENDOR=E:\ai-models\vendor

# ──────────────────────────────────────────────────────────────
# 三、运行参数
# ──────────────────────────────────────────────────────────────
# 默认使用的语言/视觉模型。注意 DeepSeek 是 reasoning 模型：
# 思考过程会先占满 max_tokens，正文可能为空 —— 调用时 max_tokens 要给足
# （实测文本任务 512 起、图像任务 1024 起）。
PAPER2VIDEO_LLM_MODEL=deepseek-flash
PAPER2VIDEO_VLM_MODEL=qwen3.5-omni-plus

# 单卡环境固定为 0；多卡写 "0,1"。留空或写空串会导致 num_gpus=0 而除零崩溃。
PAPER2VIDEO_GPU_LIST=0

# 显存偏紧时启用：数字人走 8GB 档位（Q4 + 480p）
PAPER2VIDEO_LOW_VRAM=1
