<Slide style={{ width: 1280, height: 720, display: 'flex', flexDirection: 'column', background: '#FFFFFF', fontFamily: "'Microsoft YaHei', 'PingFang SC', 'Noto Sans CJK SC', sans-serif", padding: 0 }}>
    <Box style={{ height: 72, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF' }}>Paper2Video 项目汇报</Text>
        <Text style={{ fontSize: 16, color: '#8FB6E8', letterSpacing: 2 }}>难点 4 / 4</Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', padding: '24px 40px', gap: 16 }}>
        <Box style={{ height: 44, flexDirection: 'row', alignItems: 'center', gap: 16 }}>
            <Box style={{ width: 5, height: 34, background: '#1E4FA8', borderRadius: 2 }} />
            <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0E3F8C' }}>程序说成功，产物是坏的</Text>
        </Box>

        <Box style={{ height: 492, flexDirection: 'row', gap: 24 }}>
            <Box style={{ width: 780, height: 492, flexDirection: 'column', gap: 20 }}>
                <Box style={{ height: 236, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 6, padding: '16px 18px', flexDirection: 'column', gap: 12 }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <Box style={{ width: 5, height: 26, background: '#D9534F', borderRadius: 2 }} />
                        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1A2230' }}>一、写幻灯片源码的时候</Text>
                    </Box>
                    <Box style={{ flex: 1, flexDirection: 'row', gap: 16 }}>
                        <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 4, padding: '12px 14px', flexDirection: 'column', gap: 6 }}>
                            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#8B97A8', letterSpacing: 1 }}>程序说</Text>
                            <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.45 }}>编译退出码 0，只在日志里留下一行"有非法字节被替换成替换字符"的提示</Text>
                        </Box>
                        <Box style={{ flex: 1, background: '#FCEBEB', border: '1px solid #F7C1C1', borderRadius: 4, padding: '12px 14px', flexDirection: 'column', gap: 6 }}>
                            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#A32D2D', letterSpacing: 1 }}>实际是</Text>
                            <Text style={{ fontSize: 17, color: '#1A2230', lineHeight: 1.45 }}>渲染出来的 PDF 里中文全部消失——从 PDF 里回抽文字，三个中文判据全是假</Text>
                        </Box>
                    </Box>
                </Box>

                <Box style={{ height: 236, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 6, padding: '16px 18px', flexDirection: 'column', gap: 12 }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <Box style={{ width: 5, height: 26, background: '#D9534F', borderRadius: 2 }} />
                        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1A2230' }}>二、生成数字人的时候</Text>
                    </Box>
                    <Box style={{ flex: 1, flexDirection: 'row', gap: 16 }}>
                        <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 4, padding: '12px 14px', flexDirection: 'column', gap: 6 }}>
                            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#8B97A8', letterSpacing: 1 }}>程序说</Text>
                            <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.45 }}>打印"结果已保存"，耗时也正常，没有任何异常堆栈</Text>
                        </Box>
                        <Box style={{ flex: 1, background: '#FCEBEB', border: '1px solid #F7C1C1', borderRadius: 4, padding: '12px 14px', flexDirection: 'column', gap: 6 }}>
                            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#A32D2D', letterSpacing: 1 }}>实际是</Text>
                            <Text style={{ fontSize: 17, color: '#1A2230', lineHeight: 1.45 }}>产物是一个 0 字节的空文件——整批页都"跑完了"，却一页都没生成出来</Text>
                        </Box>
                    </Box>
                </Box>
            </Box>

            <Box style={{ width: 396, height: 492, flexDirection: 'column', gap: 14 }}>
                <Box style={{ height: 176, background: '#0E3F8C', borderRadius: 8, padding: '22px 24px', flexDirection: 'column', justifyContent: 'center', gap: 8 }}>
                    <Text style={{ fontSize: 15, color: '#8FB6E8', letterSpacing: 2 }}>两次都指向同一条判据</Text>
                    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.3 }}>退出码 0<br />不等于内容正确</Text>
                </Box>

                <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 6, padding: '14px 16px', flexDirection: 'column', gap: 8, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E4FA8' }}>为什么这一类最危险</Text>
                    <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.45 }}>崩溃会停下来，它不会。它带着坏产物继续往下走，一直混进成片里，而进度条上看不出任何异常。</Text>
                    <Box style={{ height: 1, background: '#D6DCE5' }} />
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E4FA8' }}>后来的做法</Text>
                    <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.45 }}>凡是调外部工具的环节，都在结果侧再取一次样：从生成的 PDF 里把文字抽出来，查关键字符串还在不在。</Text>
                </Box>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 48, padding: '0 40px', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>数字人那个坑的成因：人脸裁剪框的宽高是奇数时，编码器直接拒绝工作</Text>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0E3F8C' }}>12 / 15</Text>
    </Box>
</Slide>
