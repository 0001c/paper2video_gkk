# 当前生成链路配置模板；复制为 .env 后填写真实凭据。
# 文本/讲稿共用兼容接口。选择其他模型时必须同步配置其服务地址。
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-你的APIKey
PAPER2VIDEO_LLM_MODEL=deepseek-flash
PAPER2VIDEO_VLM_MODEL=deepseek-flash

# v2“OpenAI 兼容 / 本地服务”：DeepSeek 官方 api.deepseek.com 已内置允许（仅 HTTPS）。
# 其他云端服务精确主机白名单，英文逗号分隔；仅填主机名，不填 https:// 或 /v1。
PAPER2VIDEO_MODEL_HOSTS=

# 可选：MiMo 只用于生成参考音色，整篇配音仍由本地 Qwen3-TTS 完成。
MIMO_API_KEY=
MIMO_API_BASE=https://api.xiaomimimo.com/v1

# 本地权重、缓存与临时目录使用纯英文路径。
HF_HOME=E:\ai-models\hf
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_ENABLE_HF_TRANSFER=0
TORCH_HOME=E:\ai-models\torch
PAPER2VIDEO_WEIGHTS=E:\ai-models\weights
PAPER2VIDEO_SMOKE_DIR=E:\ai-models\smoke
PAPER2VIDEO_VENDOR=E:\ai-models\vendor
PAPER2VIDEO_GPU_LIST=0

# 当前数字人仅保留 MuseTalk 单卡档位。
PAPER2VIDEO_MUSETALK_ROOT=E:\ai-models\MuseTalk
PAPER2VIDEO_TALKING_PROFILE=musetalk-local
# 兼容本机已经安装的解释器目录；目录名不表示仍启用 LongCat 后端。
PAPER2VIDEO_TALKING_VENV=E:\ai-models\LongCat-Video\.venv
